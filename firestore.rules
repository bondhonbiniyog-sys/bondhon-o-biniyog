rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'bondhon.biniyog@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidId(adminId);
    }

    // System Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }

    // Members Collection
    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create: if (isAdmin() || (isSignedIn() && request.auth.uid == memberId)) && isValidId(memberId);
      allow update: if (isAdmin() || (isSignedIn() && request.auth.uid == memberId)) && isValidId(memberId);
      allow delete: if isAdmin() && isValidId(memberId);
    }

    // Monthly Deposits Collection
    match /monthly_deposits/{depositId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(depositId);
      allow update: if (isAdmin() || (isSignedIn() && resource.data.member_id == request.auth.uid)) && isValidId(depositId);
      allow delete: if isAdmin() && isValidId(depositId);
    }

    // Lumpsum Deposits Collection
    match /lumpsum_deposits/{lumpsumId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(lumpsumId);
      allow update: if (isAdmin() || (isSignedIn() && resource.data.member_id == request.auth.uid)) && isValidId(lumpsumId);
      allow delete: if isAdmin() && isValidId(lumpsumId);
    }

    // Lands Collection
    match /lands/{landId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(landId);
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.member_id == 'all' || resource.data.member_id == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidId(notifId);
      allow update: if (isAdmin() || (isSignedIn() && resource.data.member_id == request.auth.uid)) && isValidId(notifId);
      allow delete: if isAdmin() && isValidId(notifId);
    }
  }
}
